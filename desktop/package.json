{
  "name": "vibebud-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for vibebud — loads core/ as a transparent floating window.",
  "author": "Shellishack",
  "main": "main.js",
  "scripts": {
    "dev": "cross-env VIBEBUD_DEV_URL=http://localhost:3060 electron .",
    "start": "electron .",
    "sync-core": "node sync-core.js",
    "make-icon": "node make-icon.js",
    "build:win": "npm run sync-core && npm run make-icon && electron-builder --win --x64",
    "build:mac": "npm run sync-core && npm run make-icon && electron-builder --mac --x64",
    "build:linux": "npm run sync-core && npm run make-icon && electron-builder --linux --x64"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "dev.vibebud.desktop",
    "productName": "vibebud",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "claude-bridge-server.js",
      "claude-sessions.js",
      "codex-sessions.js",
      "pairing.js",
      "pairing-preload.js",
      "core-out/**/*",
      "build/tray.png",
      "build/tray@2x.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "vibebud-desktop-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "vibebud-desktop.${ext}",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "vibebud-desktop.${ext}",
      "category": "Development"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
