{
  "name": "vibemoji-android",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shell for vibemoji — renders core/ as a system overlay floating on top of all other apps.",
  "scripts": {
    "open": "cap open android",
    "dev": "cross-env VIBEMOJI_DEV_URL=http://10.0.2.2:3060 cap run android --no-sync",
    "build": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/barcode-scanner": "^3.0.2",
    "@capacitor/core": "^8.3.1",
    "@capacitor/local-notifications": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "cross-env": "^10.1.0",
    "typescript": "^6.0.3"
  }
}
